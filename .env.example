GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash
# Set to 1 to run everything with a fake AI (no Gemini requests used):
USE_FAKE_AI=0
# Optional. If a model's free daily quota runs out, these are tried automatically, in order:
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# Optional:
# PORT=5000
# GRADER_TEMPERATURE=0.2

# Optional: model for the natural "AI voice" that reads questions aloud
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
