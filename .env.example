# Copy this file to .env for local use.
# Leave GEMINI_API_KEY empty (or deleted) to make every visitor paste their own free key on the website (aistudio.google.com/apikey).
# Set it only if YOU want to pay for everyone's use.
# GEMINI_API_KEY=
# 1 = ignore any Gemini key found on this computer, so the site always asks the visitor for theirs:
REQUIRE_USER_KEY=1
GEMINI_MODEL=gemini-3.5-flash
# Optional. If a model's free daily quota runs out, these are tried automatically, in order:
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# Optional:
# PORT=5000
# GRADER_TEMPERATURE=0.2

# Model for the Aoede read-aloud voice
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Public hosting only (see DEPLOY.md)
# PUBLIC=1
# Password for downloading the feedback CSV on a public site: /feedback/export.csv?key=...
# FEEDBACK_KEY=
# DAILY_AI_LIMIT=40
